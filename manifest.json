{
  "schemaVersion": 1,
  "id": "omarchy-mac-dock",
  "name": "macOS Dock",
  "version": "1.0.0",
  "author": "Hariom Joshi",
  "license": "MIT",
  "description": "macOS-style floating dock for Omarchy Linux with colorful squircle app icons, running task indicators, magnification, pre-task integrations, and interactive app management.",
  "kinds": [
    "overlay",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "overlay": "Dock.qml",
    "barWidget": "SettingsButton.qml"
  },
  "barWidget": {
    "displayName": "macOS Dock",
    "description": "macOS Dock toggle and settings",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right"
  },
  "tags": [
    "dock",
    "macos",
    "taskbar",
    "launcher",
    "hyprland"
  ]
}
